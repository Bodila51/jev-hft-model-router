# Create a key at https://console.typesafe.ai/ and keep it out of Git.
TYPESAFE_API_KEY=

# auto: use Jev when a key exists, otherwise use the deterministic demo backend.
# jev: require a working TypeSafe key.
# heuristic: offline demo only; it is not Jev.
JEV_HFT_BACKEND=auto

JEV_HFT_REGISTRY=config/model_registry.demo.json
JEV_HFT_POLICY=config/policy.json
JEV_HFT_AUDIT_LOG=data/audit.jsonl

# Optional override for the TypeSafe model alias.
JEV_HFT_MODEL=jev-latest
JEV_HFT_HOST=127.0.0.1
JEV_HFT_PORT=8000
